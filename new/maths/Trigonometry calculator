<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trigonometry Calculator</title>
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary-color: #10b981; /* Tailwind emerald-500 */
            --danger-color: #ef4444;  /* Tailwind red-500 */
        }

        body {
            background-color: #ecfdf5; /* Tailwind emerald-50 */
            font-family: 'Inter', sans-serif;
            padding: 20px 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .calculator-card {
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            border-radius: 1.5rem;
            border: none;
            max-width: 600px;
            width: 95%;
        }

        /* Input and Selection Styling */
        .input-group-text, .form-select {
            background-color: #d1fae5; /* emerald-100 */
            border-color: #a7f3d0; /* emerald-200 */
            color: #065f46;
            font-weight: 600;
            min-width: 120px;
        }
        .form-control:focus, .form-select:focus, .btn-check:checked + .btn-outline-success {
            border-color: #34d399; /* emerald-400 */
            box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
        }
        
        /* Result Styling */
        .result-container {
            margin-top: 20px;
            padding: 25px;
            border-radius: 1rem;
            text-align: center;
            background-color: var(--primary-color);
            color: white;
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
        }

        .result-box {
            background-color: rgba(255, 255, 255, 0.15);
            padding: 15px 20px;
            border-radius: 0.75rem;
            word-wrap: break-word; 
        }

        .result-label {
            font-size: 0.9rem;
            font-weight: 500;
            opacity: 0.9;
            margin-bottom: 5px;
        }
        
        .final-value {
            font-size: 2.5rem;
            font-weight: 900;
            line-height: 1.1;
        }
        
        .error-message {
            color: var(--danger-color);
            font-weight: 600;
            margin-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card calculator-card p-4 md:p-6">
                <h1 class="card-title text-center text-emerald-600 mb-5 fw-bold text-2xl md:text-3xl">Comprehensive Trigonometry Calculator</h1>
                
                <h5 class="text-emerald-500 fw-bold mb-3">Function Selection</h5>
                
                <!-- 1. Function Selector -->
                <div class="input-group mb-4 rounded-xl shadow-sm">
                    <span class="input-group-text">Function</span>
                    <select class="form-select p-3" id="trigFunction" onchange="updateUIAndRecalculate()">
                        <option value="sin" selected>Sine ($\sin(x)$)</option>
                        <option value="cos">Cosine ($\cos(x)$)</option>
                        <option value="tan">Tangent ($\tan(x)$)</option>
                        <option value="asin">Arcsine ($\arcsin(x)$)</option>
                        <option value="acos">Arccosine ($\arccos(x)$)</option>
                        <option value="atan">Arc Tangent ($\arctan(x)$)</option>
                    </select>
                </div>

                <h5 class="text-emerald-500 fw-bold mb-3" id="inputValueLabel">Input Angle ($x$)</h5>
                
                <!-- 2. Value Input -->
                <div class="input-group mb-4 rounded-xl shadow-sm">
                    <span class="input-group-text">Value</span>
                    <input type="number" class="form-control p-3" id="inputValue" value="45" step="any" required oninput="calculateTrig()">
                </div>
                
                <!-- 3. Unit Selection (Degrees/Radians) -->
                <div class="flex justify-center mb-5">
                    <div class="btn-group rounded-xl overflow-hidden shadow-sm" role="group">
                        <input type="radio" class="btn-check" name="angleUnit" id="unitDegrees" value="degrees" autocomplete="off" checked onchange="calculateTrig()">
                        <label class="btn btn-outline-success px-4 py-2" for="unitDegrees">Degrees</label>

                        <input type="radio" class="btn-check" name="angleUnit" id="unitRadians" value="radians" autocomplete="off" onchange="calculateTrig()">
                        <label class="btn btn-outline-success px-4 py-2" for="unitRadians">Radians</label>
                    </div>
                </div>

                <!-- Result Display -->
                <div class="result-container">
                    <p class="result-label mb-3 text-lg fw-bold">Result</p>
                    <div class="result-box">
                        <p class="result-label" id="resultLabel">Sine ($\sin(45^{\circ})$):</p>
                        <p class="final-value" id="finalResult">0.707</p>
                    </div>
                </div>
                
                <p class="text-center mt-3 text-sm text-gray-500" id="message">Select a function, enter a value, and choose the unit to calculate.</p>
            </div>
        </div>
    </div>
</div>

<script>
    // --- Global Elements ---
    const messageElement = document.getElementById('message');
    const functionSelector = document.getElementById('trigFunction');
    const inputValueInput = document.getElementById('inputValue');
    const unitDegrees = document.getElementById('unitDegrees');
    const unitRadians = document.getElementById('unitRadians');
    const inputValueLabel = document.getElementById('inputValueLabel');
    const resultLabel = document.getElementById('resultLabel');
    const finalResultElement = document.getElementById('finalResult');
    
    // --- Constants ---
    const ROUNDING_FACTOR = 3;
    const ASYMPTOTE_THRESHOLD = 1e-9; // Tolerance for checking division by zero

    /**
     * Helper function to display messages (error or success).
     */
    function displayMessage(msg, isError = false) {
        messageElement.innerHTML = msg; 
        if (isError) {
            messageElement.classList.add('error-message', 'text-red-500');
            messageElement.classList.remove('text-gray-500');
        } else {
            messageElement.classList.remove('error-message', 'text-red-500');
            messageElement.classList.add('text-gray-500');
        }
    }

    /**
     * Converts an angle from degrees to radians.
     * @param {number} degrees 
     * @returns {number} Angle in radians.
     */
    function toRadians(degrees) {
        return degrees * (Math.PI / 180);
    }

    /**
     * Converts an angle from radians to degrees.
     * @param {number} radians
     * @returns {number} Angle in degrees.
     */
    function toDegrees(radians) {
        return radians * (180 / Math.PI);
    }

    /**
     * Updates the UI labels based on the selected function type (Angle or Ratio).
     */
    function updateUI() {
        const func = functionSelector.value;
        const isInverse = ['asin', 'acos', 'atan'].includes(func);

        if (isInverse) {
            inputValueLabel.textContent = 'Input Ratio/Value ($x$)';
        } else {
            inputValueLabel.textContent = 'Input Angle ($x$)';
        }

        // Set a reasonable default value when switching modes
        if (isInverse && parseFloat(inputValueInput.value) > 1) {
            inputValueInput.value = '0.5';
        } else if (!isInverse && parseFloat(inputValueInput.value) < -1) {
            inputValueInput.value = '45';
        }
    }
    
    /**
     * Main calculation function for all 6 trig functions.
     */
    function calculateTrig() {
        const x = parseFloat(inputValueInput.value);
        const func = functionSelector.value;
        const unit = unitDegrees.checked ? 'degrees' : 'radians';

        // 1. Input Validation
        if (isNaN(x)) {
            finalResultElement.textContent = 'Invalid Input';
            resultLabel.textContent = 'Result:';
            displayMessage('Error: Please enter a valid number.', true);
            return;
        }

        let result;
        let inputForCalc = x;
        let operationLatex;
        let resultUnit = '';

        try {
            switch (func) {
                // --- Direct Functions (Input: Angle, Output: Ratio) ---
                case 'sin':
                case 'cos':
                    inputForCalc = unit === 'degrees' ? toRadians(x) : x;
                    result = func === 'sin' ? Math.sin(inputForCalc) : Math.cos(inputForCalc);
                    operationLatex = `\\${func}(${x}^\\circ)`; // Using degree symbol for display clarity
                    break;

                case 'tan':
                    inputForCalc = unit === 'degrees' ? toRadians(x) : x;
                    const cosine = Math.cos(inputForCalc);
                    
                    if (Math.abs(cosine) < ASYMPTOTE_THRESHOLD) {
                        finalResultElement.textContent = 'Undefined';
                        resultLabel.textContent = 'Tangent Undefined:';
                        displayMessage('Tangent is undefined near this angle ($90^{\\circ}, 270^{\\circ}, \\dots$).', true);
                        return;
                    }
                    result = Math.tan(inputForCalc);
                    operationLatex = `\\tan(${x}^\\circ)`;
                    break;

                // --- Inverse Functions (Input: Ratio, Output: Angle) ---
                case 'asin':
                case 'acos':
                    if (x < -1 || x > 1) {
                        finalResultElement.textContent = 'Domain Error';
                        resultLabel.textContent = 'Inverse Function Error:';
                        displayMessage(`Error: Input must be between -1 and 1 for Arc ${func.substring(1).toUpperCase()}.`, true);
                        return;
                    }
                    result = func === 'asin' ? Math.asin(x) : Math.acos(x);
                    operationLatex = `\\text{arc}${func.substring(1)}(${x})`;
                    // Convert result to degrees if needed
                    if (unit === 'degrees') {
                        result = toDegrees(result);
                    }
                    resultUnit = ` in ${unit.charAt(0).toUpperCase() + unit.slice(1)}`;
                    break;
                
                case 'atan':
                    result = Math.atan(x);
                    operationLatex = `\\arctan(${x})`;
                    // Convert result to degrees if needed
                    if (unit === 'degrees') {
                        result = toDegrees(result);
                    }
                    resultUnit = ` in ${unit.charAt(0).toUpperCase() + unit.slice(1)}`;
                    break;
            }

            // 2. Format and Display Result
            const result_formatted = result.toFixed(ROUNDING_FACTOR);
            finalResultElement.textContent = result_formatted;
            
            // 3. Update Labels and Message
            resultLabel.innerHTML = `${operationLatex}${resultUnit}:`;
            displayMessage(`Calculation successful! The result is $\\mathbf{${result_formatted}}$.`, false);

        } catch (e) {
            console.error(e);
            finalResultElement.textContent = 'Calculation Error';
            displayMessage('An unexpected error occurred during calculation.', true);
        }
    }
    
    /**
     * Combines UI update and recalculation when the function is changed.
     */
    function updateUIAndRecalculate() {
        updateUI();
        calculateTrig();
    }


    // --- Initialization ---
    document.addEventListener('DOMContentLoaded', () => {
        // Set initial state (default to sin(45 degrees))
        updateUI();
        calculateTrig(); 
        
        // Add event listeners to input changes
        functionSelector.addEventListener('change', updateUIAndRecalculate);
        inputValueInput.addEventListener('input', calculateTrig);
        unitDegrees.addEventListener('change', calculateTrig);
        unitRadians.addEventListener('change', calculateTrig);
    });

</script>

<!-- Bootstrap JS Bundle (required for radio button styling in some browsers) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
